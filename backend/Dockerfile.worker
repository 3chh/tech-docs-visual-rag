# PDF worker: PaddleOCR + layout detection + ghép ảnh-mục.
# Tách khỏi API service vì nạp bộ model khác và cần poppler.
#
# Worker chạy CPU, không GPU. Lý do: Paddle chưa có wheel nào biên dịch cho
# Blackwell. Image GPU chính thức mới nhất chỉ build tới sm_90 — trên RTX 5090
# (sm_120) nó chết với "Unsupported GPU architecture: compiled for 61 70 75 80
# 86 89 90, but your current GPU is 120". Đã kiểm với 3.1.0-gpu-cuda12.9.
#
# Đánh đổi chấp nhận được: index là việc offline chạy theo đợt, còn phần trả
# lời câu hỏi (ColQwen + vLLM) vẫn dùng GPU đầy đủ nên tốc độ chat không đổi.
# Bù lại worker chạy được trên máy không GPU và không tranh VRAM.
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# poppler-utils cho pdf2image; libgl/libglib cho opencv; libgomp1 cho OpenMP
# của Paddle (bắt buộc, thiếu là import paddle fail); curl cho HEALTHCHECK.
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils \
        libgl1 libglib2.0-0 libgomp1 \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

RUN groupadd --gid 1000 app && \
    useradd --uid 1000 --gid app --create-home app

COPY requirements-base.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY --chown=app:app . ./backend/
RUN touch /srv/__init__.py && chown app:app /srv/__init__.py && \
    mkdir -p /data && chown -R app:app /data

USER app

ENV DATA_DIR=/data \
    METADATA_DIR=/data/metadata \
    CONFIG_PATH=/srv/backend/config/config.yaml

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -fsS http://localhost:8001/health || exit 1

CMD ["uvicorn", "backend.worker.main:app", "--host", "0.0.0.0", "--port", "8001"]
