# PDF worker: PaddleOCR + layout detection + ghép ảnh-mục.
# Tách khỏi API service vì nạp bộ model khác và cần poppler.
#
# Dùng image chính thức của Paddle vì hai lý do:
#   1. GPU Blackwell (RTX 5090, sm_120) cần Paddle build với CUDA 12.9.
#   2. Index wheel của Paddle (paddlepaddle.org.cn/packages/...) render bằng
#      JS nên pip không đọc được link nào, và PyPI chỉ có paddlepaddle-gpu tới
#      2.6.2 — tức là không có cách nào pip cài được Paddle 3.x. Image đã có
#      Paddle + CUDA + cuDNN khớp nhau sẵn.
FROM paddlepaddle/paddle:3.1.0-gpu-cuda12.9-cudnn9.9

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# poppler-utils cho pdf2image; libgl/libglib cho opencv; curl cho HEALTHCHECK.
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils \
        libgl1 libglib2.0-0 \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

RUN groupadd --gid 1000 app && \
    useradd --uid 1000 --gid app --create-home app

COPY requirements-base.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY --chown=app:app . ./backend/
RUN touch /srv/__init__.py && chown app:app /srv/__init__.py && \
    mkdir -p /data && chown -R app:app /data

USER app

ENV DATA_DIR=/data \
    METADATA_DIR=/data/metadata \
    CONFIG_PATH=/srv/backend/config/config.yaml

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -fsS http://localhost:8001/health || exit 1

CMD ["uvicorn", "backend.worker.main:app", "--host", "0.0.0.0", "--port", "8001"]
