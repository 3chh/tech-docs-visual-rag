# Demo server: trả dữ liệu mẫu, không nạp model nào.
#
# Dùng http.server của stdlib nên không cần dependency nào ngoài Python.
# Image chỉ ~50MB thay vì vài GB như bản có CUDA.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

RUN groupadd --gid 1000 app && useradd --uid 1000 --gid app --create-home app

COPY --chown=app:app demo_server.py ./backend/demo_server.py
RUN touch /srv/__init__.py /srv/backend/__init__.py && chown -R app:app /srv

USER app

# demo_server đọc BACKEND_PORT; đặt 8000 để khớp cổng trong compose.
ENV BACKEND_PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "backend.demo_server"]
