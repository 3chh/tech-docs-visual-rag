# ============================================================
# Cosmo ChatPDF — biến môi trường
# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#
# Tối thiểu cần đặt: GEMINI_API_KEY
# Mọi thứ còn lại đã có mặc định chạy được.
# ============================================================

# --- BẮT BUỘC -----------------------------------------------
# LLM sửa cây mục lục (bước 6 của pipeline index).
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model VLM (đọc ảnh, sinh câu trả lời) -------------------
# Model này vừa được vLLM host trong stack, vừa là tên client gọi.
# Xem docs/MODEL_HOSTING.md để chọn model theo VRAM có sẵn.
VLM_MODEL_NAME=OpenGVLab/InternVL3-8B

# Tỉ lệ VRAM cấp cho vLLM. Còn lại chừa cho ColQwen (backend)
# và PaddleOCR (worker) nếu dùng chung một GPU.
#   1 GPU 24GB dùng chung  -> 0.35
#   1 GPU 48GB dùng chung  -> 0.50
#   vLLM chạy GPU riêng     -> 0.90
VLLM_GPU_MEMORY_UTILIZATION=0.35
VLLM_MAX_MODEL_LEN=8192

# Token HuggingFace — chỉ cần với model gated.
HUGGING_FACE_HUB_TOKEN=

# Key cho VLM endpoint. vLLM tự host thì để EMPTY.
OPENAI_API_KEY=EMPTY

# Chỉ dùng khi chạy với docker-compose.external-vlm.yml
# VLM_ENDPOINT=http://your-vllm-host:8000/v1

# --- Cổng (đã map khớp bản chatpdf_ver_2 cũ) ----------------
VLLM_PORT=3333
BACKEND_PORT=2005
WORKER_PORT=2222
FRONTEND_PORT=7860
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Embedding (truy xuất ảnh-mục) ---------------------------
# longcolqwen | colqwen | colpali | colidefics
EMBEDDING_TYPE=longcolqwen
EMBEDDING_MODEL_NAME=tsystems/colqwen2.5-3b-multilingual-v1.0
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=128
# Giảm xuống 4096 nếu thiếu VRAM (đánh đổi: chữ nhỏ khó đọc hơn)
EMBEDDING_MAX_NUM_VISUAL_TOKENS=8192
EMBEDDING_MIN_WIDTH=600
EMBEDDING_BATCHING_MODE=dynamic
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_TOKEN=13000

# --- Vector database -----------------------------------------
# qdrant-standalone | milvus-lite | milvus-standalone
VECTORDB_TYPE=qdrant-standalone
VECTORDB_DATABASE_NAME=cosmo
VECTORDB_COLLECTION_NAME=context
VECTORDB_SEARCH_LIMIT=16384

# --- LLM sửa mục lục -----------------------------------------
TOC_VALIDATOR_TYPE=gemini
TOC_VALIDATOR_MODEL_NAME=gemini-2.0-flash
TOC_VALIDATOR_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
TOC_VALIDATOR_TEMPERATURE=0.6

# --- Khác ------------------------------------------------------
FRONTEND_SEARCH_TIMEOUT=1000
LOG_LEVEL=INFO
