# ============================================================
# Cosmo ChatPDF — biến môi trường
# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
# ============================================================

# --- Đường dẫn dữ liệu ---
# Nơi lưu ảnh-mục, metadata, summary_report.json của từng collection
DATA_DIR=./data
METADATA_DIR=./data/metadata

# --- Vector database ---
# Chọn: qdrant-standalone | milvus-lite | milvus-standalone
VECTORDB_TYPE=qdrant-standalone
VECTORDB_URI=http://qdrant:6333
VECTORDB_GRPC_PORT=6334
VECTORDB_TOKEN=
VECTORDB_DATABASE_NAME=cosmo
VECTORDB_COLLECTION_NAME=context
VECTORDB_SEARCH_LIMIT=16384

# --- Embedding model ---
# Chọn: longcolqwen | colqwen | colpali | colidefics
EMBEDDING_TYPE=longcolqwen
EMBEDDING_MODEL_NAME=tsystems/colqwen2.5-3b-multilingual-v1.0
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=128
EMBEDDING_MAX_NUM_VISUAL_TOKENS=8192
EMBEDDING_MIN_WIDTH=600
EMBEDDING_BATCHING_MODE=dynamic
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_TOKEN=13000

# --- VLM sinh câu trả lời (đọc ảnh) ---
VLM_TYPE=openai
VLM_ENDPOINT=http://your-vllm-host:8000/v1
VLM_MODEL_NAME=OpenGVLab/InternVL3-78B-AWQ
# Bắt buộc khi VLM_TYPE=openai
OPENAI_API_KEY=EMPTY

# --- LLM sửa cây mục lục (ToC validator) ---
# Chọn: gemini | openai
TOC_VALIDATOR_TYPE=gemini
TOC_VALIDATOR_MODEL_NAME=gemini-2.0-flash
TOC_VALIDATOR_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
TOC_VALIDATOR_TEMPERATURE=0.6
# Bắt buộc khi TOC_VALIDATOR_TYPE=gemini
GEMINI_API_KEY=

# --- Địa chỉ service (nội bộ docker network) ---
PDF_WORKER_ENDPOINT=http://worker:8001/upload_pdf/
BACKEND_URL=http://backend:8000

# --- Port expose ra host ---
BACKEND_PORT=8000
WORKER_PORT=8001
FRONTEND_PORT=7860
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Frontend ---
FRONTEND_SEARCH_TIMEOUT=1000
GRADIO_SERVER_NAME=0.0.0.0

# --- Log ---
LOG_LEVEL=INFO
