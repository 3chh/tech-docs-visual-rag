# ============================================================
# Cosmo ChatPDF — biến môi trường
# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#
# Tối thiểu cần đặt: CREDENTIALS_SECRET
# Mọi thứ còn lại đã có mặc định chạy được.
# ============================================================

# --- KHÔNG CÒN API KEY Ở ĐÂY ---------------------------------
# API key nay do người dùng nhập trên giao diện, lưu mã hoá trong
# data/model_connections.json.
#
# Luồng dùng:
#   1. Mở giao diện, vào Cấu hình, thêm kết nối mô hình (OpenAI, Gemini,
#      vLLM tự host, hoặc endpoint tuỳ chỉnh). Cần ít nhất một mô hình
#      biết đọc ảnh (vlm) và một mô hình văn bản (llm) — một mô hình đa
#      phương thức như GPT-4o hay Gemini Flash làm được cả hai.
#   2. Tạo bộ tài liệu, chọn mô hình cho bộ đó
#   3. Tải PDF lên
# Chưa làm bước 1 và 2 thì không thêm được tài liệu.

# --- BẮT BUỘC ------------------------------------------------
# Khoá mã hoá at-rest cho API key người dùng nhập. Sinh bằng:
#   openssl rand -base64 32
# Đổi khoá này thì mọi key đã lưu không giải mã được nữa, phải nhập lại.
CREDENTIALS_SECRET=

# --- vLLM tự host trong stack (chỉ profile full) -------------
# Model mà service vllm sẽ serve.
VLM_MODEL_NAME=OpenGVLab/InternVL3-8B

# builtin = tự tạo sẵn kết nối tới vLLM trong stack, dùng được ngay sau
#           `make deploy-full` mà không phải nhập endpoint nội bộ.
# none    = người dùng tự thêm kết nối trên giao diện (hybrid, demo).
# make deploy-full tự đặt biến này thành builtin.
DEFAULT_VLM_PROVIDER=none
# Đổi khi vLLM chạy ở máy khác.
# BUILTIN_VLM_ENDPOINT=http://vllm:8000/v1

# Tỉ lệ VRAM của CẢ card mà vLLM được dùng, tính cả weights lẫn KV cache.
# InternVL3-8B ở bf16 nặng ~16GB, cộng KV cache thành ~20GB:
#   card 32GB -> 0.60   (còn ~12GB cho ColQwen ~10GB, khá sát)
#   card 24GB -> KHÔNG đủ cho model này. Đổi VLM_MODEL_NAME sang
#                OpenGVLab/InternVL3-2B rồi dùng 0.25, hoặc chạy deploy-hybrid.
#   vLLM có card riêng -> 0.90
VLLM_GPU_MEMORY_UTILIZATION=0.60
VLLM_MAX_MODEL_LEN=8192

# Token HuggingFace — chỉ cần với model gated.
HUGGING_FACE_HUB_TOKEN=

# Số GPU cấp cho vllm và backend. Worker không dùng GPU (Paddle chạy CPU).
GPU_COUNT=1

# Số luồng CPU cho PaddleOCR ở worker. Để trống = mặc định của Paddle (bằng
# số core). Đặt thấp hơn nếu máy dùng chung và không muốn chiếm hết CPU.
# OMP_NUM_THREADS=16

# --- Cổng (đã map khớp bản chatpdf_ver_2 cũ) ----------------
VLLM_PORT=3333
BACKEND_PORT=2005
WORKER_PORT=2222
FRONTEND_PORT=7860
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Interface được phơi cổng ra. 0.0.0.0 = mọi interface (mặc định, tiện cho
# máy local). make deploy-prod tự đặt 127.0.0.1 để chỉ Caddy ra Internet.
BIND_ADDR=0.0.0.0

# --- Embedding (truy xuất ảnh-mục) ---------------------------
#
# EMBEDDING_MAX_NUM_VISUAL_TOKENS và EMBEDDING_MIN_WIDTH ở đây chỉ là MẶC ĐỊNH
# cho bộ tài liệu mới. Mỗi bộ chốt giá trị riêng lúc tạo và đóng băng sau đó,
# vì vector chỉ so được với vector cùng tham số. Đổi ở đây không ảnh hưởng bộ
# đã tạo.
#
# EMBEDDING_TYPE và EMBEDDING_MODEL_NAME thì khác: chúng quyết định model nào
# nạp vào VRAM nên là giá trị toàn cục thật. Đổi hai biến này làm mọi bộ đã
# index báo lệch và không tra cứu được — phải index lại.
#
# longcolqwen | colqwen | colpali | colidefics
EMBEDDING_TYPE=longcolqwen
EMBEDDING_MODEL_NAME=tsystems/colqwen2.5-3b-multilingual-v1.0
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=128
# Giảm xuống 4096 nếu thiếu VRAM (đánh đổi: chữ nhỏ khó đọc hơn)
EMBEDDING_MAX_NUM_VISUAL_TOKENS=8192
EMBEDDING_MIN_WIDTH=600
EMBEDDING_BATCHING_MODE=dynamic
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_TOKEN=13000

# --- Vector database -----------------------------------------
# qdrant-standalone | milvus-lite | milvus-standalone
VECTORDB_TYPE=qdrant-standalone
VECTORDB_DATABASE_NAME=cosmo
VECTORDB_COLLECTION_NAME=context
VECTORDB_SEARCH_LIMIT=16384


# --- Khác ------------------------------------------------------
FRONTEND_SEARCH_TIMEOUT=1000
LOG_LEVEL=INFO


# ============================================================
# TRIỂN KHAI LÊN SERVER CÔNG KHAI (make deploy-prod)
# ============================================================
# Chỉ cần khi chạy deploy-prod. Caddy sẽ tự xin chứng chỉ Let's Encrypt.

# DOMAIN=chatpdf.congty.vn
# ACME_EMAIL=ops@congty.vn
# BASIC_AUTH_USER=cosmo
# Sinh hash: docker run --rm caddy caddy hash-password --plaintext 'matkhau'
# BASIC_AUTH_HASH=

# ============================================================
# TRIỂN KHAI TÁCH MÁY (make deploy-gpu-node)
# ============================================================
# Địa chỉ worker ở máy A, dùng khi backend và worker khác máy.

# PDF_WORKER_ENDPOINT=http://10.0.0.5:2222/upload_pdf/
